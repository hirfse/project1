    function updateCategoryDiscountLabel() {
        const discountType = document.getElementById('categoryDiscountType').value;
        const label = document.getElementById('categoryDiscountValueLabel');
        const maxInput = document.getElementById('categoryMaxDiscount');
        const maxGroup = maxInput && maxInput.parentElement;

        if (discountType === 'percentage') {
            label.textContent = 'Discount Percentage (%) *';
            document.getElementById('categoryDiscountValue').max = '100';
            if (maxGroup) {
                maxGroup.style.display = '';
                maxInput.required = true;
            }
        } else if (discountType === 'fixed') {
            label.textContent = 'Discount Amount (₹) *';
            document.getElementById('categoryDiscountValue').removeAttribute('max');
            if (maxGroup) {
                maxGroup.style.display = 'none';
                maxInput.required = false;
                maxInput.value = '0';
            }
        } else {
            label.textContent = 'Discount Value *';
            if (maxGroup) {
                maxGroup.style.display = '';
                maxInput.required = true;
            }
        }
    }

