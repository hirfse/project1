                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Failed to delete offer'
                    });
                });
            }
        });
    }

    function toggleCategoryOfferStatus(offerId) {
        fetch(`/admin/category-offer/${offerId}/toggle-status`, {
            method: 'PATCH'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: data.message,
                    timer: 2000,
                    showConfirmButton: false
                });
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Failed to toggle offer status'
            });
        });
    }

    // Referral Offer Modal Functions
    function openAddReferralOfferModal() {
        document.getElementById('referralOfferModalTitle').textContent = 'Add Referral Offer';
        document.getElementById('submitReferralOffer').textContent = 'Add Offer';
        document.getElementById('referralOfferForm').reset();
        document.getElementById('referralOfferId').value = '';
        document.getElementById('referralOfferModal').style.display = 'block';

        const now = new Date();
        const today = now.toISOString().slice(0, 16);
        document.getElementById('referralStartDate').min = today;
        document.getElementById('referralEndDate').min = today;
    }

    function closeReferralOfferModal() {
        document.getElementById('referralOfferModal').style.display = 'none';
        document.getElementById('referralOfferForm').reset();
    }

    // Referral Offer Form submission
    document.getElementById('referralOfferForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const data = {};
        for (let [key, value] of formData.entries()) {
            data[key] = value;
        }
        data.isActive = document.getElementById('referralIsActive').checked;

        try {
            const offerId = document.getElementById('referralOfferId').value;
            const url = offerId ? `/admin/referral-offer/${offerId}` : '/admin/add-referral-offer';
            const method = offerId ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                Swal.fire({ icon: 'success', title: 'Success!', text: result.message, timer: 2000, showConfirmButton: false });
                closeReferralOfferModal();
                setTimeout(() => window.location.reload(), 2000);
            } else {
                Swal.fire({ icon: 'error', title: 'Error!', text: result.message });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({ icon: 'error', title: 'Error!', text: 'Something went wrong. Please try again.' });
        }
    });

    function editReferralOffer(offerId) {
        fetch(`/admin/referral-offer/${offerId}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    return Swal.fire({ icon: 'error', title: 'Error!', text: data.message });
                }
                const offer = data.offer;
                document.getElementById('referralOfferModalTitle').textContent = 'Edit Referral Offer';
                document.getElementById('submitReferralOffer').textContent = 'Update Offer';
                document.getElementById('referralOfferId').value = offer._id;
                document.getElementById('referralName').value = offer.name;
                document.getElementById('referralDescription').value = offer.description;
                document.getElementById('referrerRewardType').value = offer.referrerRewardType;
                document.getElementById('referrerRewardValue').value = offer.referrerRewardValue;
                document.getElementById('referrerMaxReward').value = offer.referrerMaxReward;
                document.getElementById('refereeRewardType').value = offer.refereeRewardType;
                document.getElementById('refereeRewardValue').value = offer.refereeRewardValue;
                document.getElementById('refereeMaxReward').value = offer.refereeMaxReward;
                document.getElementById('minPurchaseAmount').value = offer.minPurchaseAmount || 0;
                document.getElementById('maxReferralsPerUser').value = offer.maxReferralsPerUser || 10;
                document.getElementById('referralIsActive').checked = offer.isActive;

                const startDate = new Date(offer.startDate);
                const endDate = new Date(offer.endDate);
                document.getElementById('referralStartDate').value = startDate.toISOString().slice(0, 16);
                document.getElementById('referralEndDate').value = endDate.toISOString().slice(0, 16);

                document.getElementById('referralOfferModal').style.display = 'block';
            })
            .catch(err => {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to fetch offer details' });
            });
    }

    function deleteReferralOffer(offerId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/admin/referral-offer/${offerId}`, { method: 'DELETE' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Deleted!', text: data.message, timer: 2000, showConfirmButton: false });
                            setTimeout(() => window.location.reload(), 2000);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error!', text: data.message });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to delete offer' });
                    });
            }
        });
    }

    function toggleReferralOfferStatus(offerId) {
        fetch(`/admin/referral-offer/${offerId}/toggle-status`, { method: 'PATCH' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Success!', text: data.message, timer: 2000, showConfirmButton: false });
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error!', text: data.message });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Error!', text: 'Failed to toggle offer status' });
            });
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
        const productModal = document.getElementById('productOfferModal');
        const categoryModal = document.getElementById('categoryOfferModal');
        const referralModal = document.getElementById('referralOfferModal');

        if (event.target === productModal) {
            closeProductOfferModal();
        }
        if (event.target === categoryModal) {
            closeCategoryOfferModal();
        }
        if (event.target === referralModal) {
            closeReferralOfferModal();
        }
    }
    </script>
</body>
</html>