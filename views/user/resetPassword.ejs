<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        body {
            background-image: url("/images/background/milad-fakurian-7wUorDiCMSU-unsplash.jpg");
        }

        .rightHeader p {
            font-size: 28px;
            font-weight: 600;
            letter-spacing: 2px;
            margin-top: 10px;
            text-align: center;
            color: white;
        }

        .rightBody label {
            font-size: 14px;
            color: white;
            margin-bottom: 5px;
        }

        .rightBody p {
            color: red;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .rightBody button {
            width: 100%;
            height: 45px;
            border-radius: 50px;
            background-color: #992828;
            color: white;
            font-size: large;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .rightBody button:hover {
            background-color: #7a1f1f;
        }
    </style>
</head>

<body>
    <%- include('../partials/loginHeader') %>

        <main>
            <div class="loginContainer">
                <div class="loginLeft">
                    <img id="loginImage" src="/images/background/linevector.png" alt="Line Vector">
                </div>
                <div class="loginRight">
                    <div class="rightHeader">
                        <img src="/images/background/U-Craft_logo.png" alt="U-Craft Logo" id="loginHeadLogo">
                        <p>Reset Your Password</p>
                    </div>
                    <div class="rightBody">
                        <form action="/resetPassword" method="post" onsubmit="return validateResetPassword(event)">
                            <!-- Hidden input to pass the email -->
                            <input type="hidden" name="email" value="<%= email %>">

                            <label for="password">New Password</label>
                            <% if (msg) { %>
                                <p>
                                    <%= msg %>
                                </p>
                                <% } %>
                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your new password">
                                    <div id="errorPass" style="color: red; font-size: 13px;"></div>

                                    <label for="confirmPassword">Confirm Password</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                        placeholder="Confirm your new password">
                                    <div id="errorPass2" style="color: red; font-size: 13px;"></div>

                                    <button type="submit">Reset Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
        <script>
            function validateResetPassword(event) {
                document.getElementById('errorPass').textContent = '';
                document.getElementById('errorPass2').textContent = '';

                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                let isValid = true;

                const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;

                if (!password) {
                    document.getElementById('errorPass').textContent = 'Password is required';
                    isValid = false;
                } else if (!passwordRegex.test(password)) {
                    document.getElementById('errorPass').textContent = 'Password must be at least 8 chars, include uppercase, lowercase, number, and special character.';
                    isValid = false;
                }

                if (!confirmPassword) {
                    document.getElementById('errorPass2').textContent = 'Confirm Password is required';
                    isValid = false;
                } else if (password !== confirmPassword) {
                    document.getElementById('errorPass2').textContent = 'Passwords do not match';
                    isValid = false;
                }

                if (!isValid) {
                    event.preventDefault();
                    return false;
                }
                return true;
            }
        </script>
</body>

</html>