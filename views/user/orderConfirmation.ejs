<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Confirmation - U-Craft</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap" rel="stylesheet">
    <style>
        /* Importing Poppins font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

/* Base styles for the order confirmation page */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    height: 100%;
    font-family: 'Poppins', sans-serif;
    background-image: url('/images/background/gray-wood-texture.jpg');
    background-size: contain;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Header styles (matching product listing) */
.mainhead {
    display: flex;
    justify-content: space-between;
    margin: 10px;
    align-items: center;
}
.buttons {
    display: flex;
    gap: 10px;
    align-items: center;
}
.buttons .searchBar {
    width: 15rem;
    background-color: transparent;
    border: 1px solid #ccc;
    padding: 8px;
    border-radius: 4px;
}
.buttons img { height: 25px; cursor: pointer; }
.buttons img:hover { filter: contrast(0); }
.buttons button { padding: 8px 15px; border-radius: 4px; border: 1px solid #ccc; background-color: #fff; cursor: pointer; }
.buttons button:hover { background-color: #403f3f; color: #f0f8ff; }
.modal { display: none; position: absolute; top: 50px; right: 10px; z-index: 1000; }
.modal-content { background-color: #ffffff; padding: 15px; border: 1px solid #888; border-radius: 8px; width: 300px; box-shadow: 0px 0px 10px rgba(0,0,0,0.2); text-align: center; }
.modal-content ul { list-style: none; }
.modal-content li { padding: 2px; color: #333; }
.modal-content a { text-decoration: none; color: #333; }
.modal-content a:hover { color: #000; }
.subhead { display: flex; justify-content: center; align-items: center; }
.subhead nav ul { display: flex; list-style: none; gap: 20px; }
.subhead nav a { text-decoration: none; color: #333; }
.subhead nav a:hover { color: #000; }

/* Main content */
main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 20px;
    flex: 1;
}

.confirmation-container {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    box-shadow: 0 8px 9px rgba(0, 0, 0, 0.1);
    padding: 32px;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
}

.confirmation-container h2 {
    font-size: 30px;
    font-weight: 700;
    color: #16a34a;
    margin-bottom: 16px;
}

.confirmation-container p {
    font-size: 16px;
    color: #333;
    margin-bottom: 24px;
}

.confirmation-container h3 {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
}

.address-details p {
    font-size: 16px;
    color: #333;
    margin: 4px 0;
}

.address-details p strong {
    font-weight: 600;
}

.order-items ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.order-items ul li {
    font-size: 16px;
    color: #333;
    padding: 8px 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
}

.continue-shopping-btn {
    background-color: #2563eb;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    border-radius: 4px;
    padding: 8px 24px;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.3s ease;
}

.continue-shopping-btn:hover {
    background-color: #1d4ed8;
}

/* Footer */
footer {
    background-color: #000;
    color: #fff;
    padding: 40px 0;
    width: 100%;
    margin-top: auto;
}

footer .container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
}

footer p {
    font-size: 16px;
    font-weight: 500;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    main {
        padding: 24px 16px;
    }

    .confirmation-container {
        padding: 24px;
    }

    header .container {
        flex-direction: column;
        gap: 16px;
    }

    header nav {
        flex-wrap: wrap;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    main {
        padding: 16px 10px;
    }

    .confirmation-container {
        padding: 16px;
    }

    .confirmation-container h2 {
        font-size: 24px;
    }

    .confirmation-container h3 {
        font-size: 18px;
    }

    .confirmation-container p,
    .order-items ul li,
    .continue-shopping-btn {
        font-size: 14px;
    }
}
    </style>
</head>
<body class="bg-gray-100 font-sans">
    <header>
        <div class="mainhead">
            <p>U-Craft .</p>
            <div class="buttons">
                <form method="GET" action="/productListing" class="search">
                    <input type="text" class="searchBar" name="search" placeholder="Search product...">
                </form>
                <img src="/images/project_icons/profile.png" alt="profile" onmouseover="profileViewModal()" class="profileImg">
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit">Logout</button>
                </form>
            </div>
            <div id="profileViewModal" class="modal">
                <div class="modal-content" onmouseleave="closeViewModal()">
                    <% if (userName) { %>
                        <p>Welcome, <strong><%= userName.toUpperCase() %></strong>!</p>
                    <% } else { %>
                        <p><a href="/login">Login</a> | <a href="/signup">Signup</a></p>
                    <% } %>
                    <ul>
                        <a href="/profile"><li>Profile</li></a>
                        <a href="/wishlist"><li>Wish List</li></a>
                        <a href="/cart"><li>Cart</li></a>
                        <a href="/wallet"><li>Wallet</li></a>
                    </ul>
                </div>
            </div>
        </div>
        <div class="subhead">
            <nav>
                <ul>
                    <a href="/"><li>Home</li></a>
                    <a href="/productListing"><li>Shop</li></a>
                    <a href="/customListing"><li>Custom</li></a>
                    <a href="/about"><li>About</li></a>
                    <a href="/contact"><li>Contact</li></a>
                </ul>
            </nav>
        </div>
    </header>
    <!-- Breadcrumbs -->
    <nav id="breadcrumbs" style="margin: 18px 0 0 30px;"></nav>
    <main class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow p-8 max-w-xl mx-auto text-center">
            <h2 class="text-3xl font-semibold text-green-600 mb-4"><%= message || 'Order placed successfully!' %></h2>
            <p class="mb-6 text-gray-700">Thank you for shopping with U-Craft<% if (userName) { %>, <%= userName %><% } %>!</p>
            <div class="mb-6">
                <h3 class="text-xl font-semibold mb-2">Delivery Address</h3>
                <% if (orderDetails && orderDetails.address) { %>
                    <div class="text-gray-700">
                        <p><strong><%= orderDetails.address.fullName %></strong> (<%= orderDetails.address.addressType %>)</p>
                        <p><%= orderDetails.address.houseName %>, <%= orderDetails.address.city %>, <%= orderDetails.address.state %> - <%= orderDetails.address.pincode %></p>
                        <p>Phone: <%= orderDetails.address.phone %> <% if (orderDetails.address.secPhone) { %>, Alt: <%= orderDetails.address.secPhone %><% } %></p>
                        <p>Landmark: <%= orderDetails.address.landMark %></p>
                    </div>
                <% } else { %>
                    <p>No address information available.</p>
                <% } %>
            </div>
            <div class="mb-6">
                <h3 class="text-xl font-semibold mb-2">Order Items</h3>
                <% if (orderDetails && orderDetails.items && orderDetails.items.length > 0) { %>
                    <ul class="divide-y divide-gray-200">
                        <% orderDetails.items.forEach(function(item) { %>
                            <li class="py-2 flex items-center justify-between">
                                <span>
                                    <%= (item.productName) || (item.productId && item.productId.productName) || 'Product' %>
                                    (x<%= item.quantity %>)
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p>No items found in this order.</p>
                <% } %>
            </div>
            <a href="/home" class="inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">Continue Shopping</a>
        </div>
    </main>
    <footer class="bg-gray-800 text-white py-4 mt-8">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2025 U-Craft. All rights reserved.</p>
        </div>
    </footer>

    <script>
        function profileViewModal() {
            const el = document.getElementById('profileViewModal');
            if (el) el.style.display = 'block';
        }
        function closeViewModal() {
            const el = document.getElementById('profileViewModal');
            if (el) el.style.display = 'none';
        }
        // Dynamic Breadcrumbs (same pattern used elsewhere)
        (function() {
            const prettyNames = { '': 'Home', 'home': 'Home', 'productlisting': 'Shop', 'customlisting': 'Custom', 'profile': 'Profile', 'cart': 'Cart', 'wishlist': 'Wishlist', 'addresses': 'Addresses', 'orders': 'Orders', 'checkout': 'Checkout', 'about': 'About', 'contact': 'Contact', 'order-confirmation': 'Order Confirmation' };
            const path = window.location.pathname.replace(/^\/+|\/+$/g, '').split('/');
            let crumbs = []; let url = '';
            for (let i = 0; i < path.length; i++) { url += '/' + path[i]; crumbs.push({ name: (prettyNames[path[i]?.toLowerCase()] || (path[i].charAt(0).toUpperCase() + path[i].slice(1))), url: i < path.length - 1 ? url : null }); }
            if (crumbs.length === 0 || crumbs[0].name !== 'Home') { crumbs.unshift({ name: 'Home', url: '/' }); }
            const nav = document.getElementById('breadcrumbs');
            if (nav) {
                nav.innerHTML = '<ol style="list-style:none;display:flex;gap:5px;font-size:14px;color:#888;">' +
                crumbs.map((c, idx) => c.url ? `<li><a href="${c.url}" style="color:#888;text-decoration:none;">${c.name}</a></li>` + (idx < crumbs.length - 1 ? '<li style="color:#888;">/</li>' : '') : `<li style="color:#333;">${c.name}</li>`).join('') + '</ol>';
            }
        })();
    </script>
</body>
</html>
